// Icone, manifesto e informacoes do MorphoDiagnostico.exe.
#include <winver.h>

1 ICON "..\\..\\packaging\\launcher\\morpho.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "Morpho"
            VALUE "FileDescription", "Morpho - diagnostico de compatibilidade"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "MorphoDiagnostico"
            VALUE "OriginalFilename", "MorphoDiagnostico.exe"
            VALUE "ProductName", "Morpho"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
